{
    "builds": [
        {
            "src": "config/wsgi.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "config/wsgi.py"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/sync-odoo",
            "schedule": "0 */6 * * *"
        }
    ]
}